    <!-- Analytics — after first paint so head parse does not delay FCP -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      (function () {
        var loaded = false;
        function loadGtag() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-9GP4FZEQLC";
          document.head.appendChild(s);
          gtag("js", new Date());
          gtag("config", "G-9GP4FZEQLC", { send_page_view: false });
        }
        ["pointerdown", "keydown", "touchstart"].forEach(function (evt) {
          window.addEventListener(evt, loadGtag, { once: true, passive: true });
        });
        window.addEventListener("load", function () {
          setTimeout(loadGtag, 15000);
        });
      })();
    </script>
    <script>
